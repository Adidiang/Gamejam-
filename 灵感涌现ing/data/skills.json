    {
      "id": "a_skill_1",
      "name": "白日梦",
      "description": "自己工作或执行任务时有50%概率睡着，取消本次产出。任务仍消耗行动步数，但保留年度任务次数。",
      "quip": "我再确认一遍，她只是连睡了一个星期而不是死了对吧？",
      "acquisition": "auto",
      "inspiration_cost": 0,
      "triggers": [
        {
          "hook": "ACTION_BEFORE",
          "conditions": {
            "action_kind": "task",
            "actor_is_owner": true
          },
          "target": "owner",
          "frequency": "event",
          "effect_id": "sheep_skill",
          "params": {
            "mode": "sleep",
            "probability": 0.5
          },
          "priority": 0
        },
        {
          "hook": "DUTY_BEFORE",
          "conditions": {},
          "target": "owner",
          "frequency": "event",
          "effect_id": "sheep_skill",
          "params": {
            "mode": "sleep",
            "probability": 0.5
          },
          "priority": 0
        }
      ]
    },
